# Microsoft Clarity — clarity.microsoft.com → your project → Settings → Setup → Project ID.
# Set this in Vercel → Project → Settings → Environment Variables for "Production" only,
# so previews and local dev never record sessions. (Clarity also only runs in production builds.)
VITE_CLARITY_PROJECT_ID=

# Visit alerts (api/visit.js): a Discord channel → Edit Channel → Integrations → Webhooks →
# New Webhook → Copy Webhook URL. Set it in Vercel's Environment Variables for "Production"
# only; it's read by the server function, never shipped to the page, so it must NOT start with VITE_.
DISCORD_WEBHOOK_URL=

# Shared memory for the visit alerts' limits and "one alert per visit" (optional but recommended):
# Vercel → Storage (or Marketplace) → Upstash for Redis → free plan → connect it to this project.
# Vercel adds these itself as <prefix>_REST_API_URL / _TOKEN (any prefix works; KV is the usual). Without them the
# limits live in each server instance's memory, which a spread-out flood can get around.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile, the human check in front of the résumé (and every page during a flood):
# dash.cloudflare.com → Turnstile → Add widget → hostnames aswinkumar.dev and www.aswinkumar.dev,
# mode "Managed". Set both in Vercel for Production; the secret one marked Sensitive. Until they're
# set, the résumé downloads with only the rate limit in front of it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
